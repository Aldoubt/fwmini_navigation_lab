<?xml version="1.0"?>
<package format="3">
  <name>fwmini_odom_adapter</name>
  <version>0.1.0</version>
  <description>FW-mini isolated fwmini_odom_adapter for ROS 2 Humble</description>
  <maintainer email="maintainer@example.com">FW-mini maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
